{
  "annotations": { "list": [] },
  "editable": true,
  "title": "PulseTrack - DevOps Capstone Observability",
  "uid": "pulsetrack-capstone",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (RPS) by Track",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (track) (rate(http_requests_total[1m]))",
          "legendFormat": "{{track}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "P95 Request Latency (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, track))",
          "legendFormat": "p95 {{track}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active Tasks by Priority",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "pulsetrack_active_tasks",
          "legendFormat": "{{priority}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "5xx Error Rate (%)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 1)",
          "legendFormat": "5xx %"
        }
      ]
    }
  ]
}
